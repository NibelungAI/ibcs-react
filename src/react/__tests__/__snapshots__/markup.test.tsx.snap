exports[`component markup snapshots > Report renders stable markup 1`] = `
"<div class="ibcs-report" style="font-family:ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;color:#2b2b29">
<style>
@media screen and (max-width: 760px) {
  .ibcs-report-grid[data-collapse="760"] { grid-template-columns: 1fr !important; }
  .ibcs-report-grid[data-collapse="760"] > * { grid-column: auto !important; }
}
</style>
<header style="margin-bottom:16px">
<div style="font-size:20px;font-weight:600">Q4 review</div>
</header>
<div class="ibcs-report-grid" data-collapse="760" style="display:grid;grid-template-columns:repeat(12, 1fr);gap:14px;align-items:stretch">
<section class="ibcs-report-block" data-block-type="text" data-block-id="intro" style="background:#fff;border-radius:8px;padding:15px 17px;box-sizing:border-box;border:1px solid #e6e5e0;grid-column:span 12;min-width:0;display:flex;flex-direction:column">
<div style="margin-bottom:12px">
