"<div style="position:relative;min-width:0;font-family:ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif">
<style>
.ibcs-stmt tbody tr:not(.ibcs-row-pad) > * { transition: background 90ms }
.ibcs-stmt tbody tr:not(.ibcs-row-pad):hover > * { background: rgba(0,0,0,0.025) }
@media (prefers-reduced-motion: reduce) { .ibcs-stmt tbody tr > * { transition: none } }

@keyframes ibcsRowIn { from { opacity: 0 } to { opacity: 1 } }
@media (prefers-reduced-motion: reduce) { tr.ibcs-row { animation: none !important; opacity: 1 !important } }
</style>
<div style="overflow-x:auto">
<table class="ibcs-stmt" style="border-collapse:collapse;width:100%;min-width:min-content">
<thead>
<tr style="border-bottom:2px solid #2b2b29">
<th scope="col" style="font-size:11px;font-weight:500;color:#6b6a64;padding:0 10px 8px;text-align:left;white-space:nowrap"> </th>
<th scope="col" style="font-size:11px;font-weight:500;color:#6b6a64;padding:0 10px 8px;text-align:right;white-space:nowrap">PY</th>
<th scope="col" style="font-size:11px;font-weight:500;color:#6b6a64;padding:0 10px 8px;text-align:left;white-space:nowrap;padding-left:8px;width:260px">AC</th>
<th scope="col" style="font-size:11px;font-weight:500;color:#6b6a64;padding:0 10px 8px;text-align:center;white-space:nowrap;width:108px">ΔPY</th>
<th scope="col" style="font-size:11px;font-weight:500;color:#6b6a64;padding:0 10px 8px;text-align:center;white-space:nowrap;width:150px">ΔPY%</th>
</tr>
</thead>
<tbody>
<tr class="ibcs-row" style="border-top:none;height:34px;animation:ibcsRowIn 360ms ease-out 0ms both">
