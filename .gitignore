demo-dist

# Playwright visual regression run output (reports, traces, actual/diff PNGs).
playwright-report/
test-results/

# Screenshot baselines are platform-specific. Only the LINUX set is committed —
# it is generated by .github/workflows/visual.yml and is what CI compares
# against. Local win32/darwin baselines are scratch for eyeballing diffs.
tests/visual/__screenshots__/*
!tests/visual/__screenshots__/linux/
